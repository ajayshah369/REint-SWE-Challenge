# Default: Vite /api requests go to Docker's Nginx on local port 80.
# If running Python directly instead of Docker, set this in .env.local:
# API_PROXY_TARGET=http://127.0.0.1:8000

# Leave unset to use the same-origin /api proxy.
# For deployment with a separate backend origin, include its /api suffix:
# VITE_API_BASE_URL=https://your-backend.example.com/api
